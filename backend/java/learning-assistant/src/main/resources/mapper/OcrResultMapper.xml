<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.learning.mapper.OcrResultMapper">

    <select id="findByMaterialId" resultType="com.campus.learning.entity.OcrResult">
        SELECT * FROM ocr_result WHERE material_id = #{materialId} LIMIT 1
    </select>

</mapper>
