package com.campus.learning.repository;

import com.campus.learning.entity.Material;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface MaterialRepository extends JpaRepository<Material, Long> {

    // 按用户ID查询
    List<Material> findByUserIdOrderByCreatedAtDesc(Long userId);

    // 关键词搜索（匹配 keywords 字段）
    @Query("SELECT m FROM Material m WHERE m.keywords LIKE %:keyword% ORDER BY m.createdAt DESC")
    Page<Material> searchByKeywords(@Param("keyword") String keyword, Pageable pageable);

    // 全文搜索（匹配 ocr_text 和 filename）
    @Query("SELECT m FROM Material m WHERE m.ocrText LIKE %:keyword% OR m.filename LIKE %:keyword% OR m.summary LIKE %:keyword% ORDER BY m.createdAt DESC")
    Page<Material> searchByText(@Param("keyword") String keyword, Pageable pageable);

    // 综合搜索（所有字段）
    @Query("SELECT m FROM Material m WHERE " +
            "m.keywords LIKE %:keyword% OR " +
            "m.ocrText LIKE %:keyword% OR " +
            "m.filename LIKE %:keyword% OR " +
            "m.summary LIKE %:keyword% " +
            "ORDER BY m.createdAt DESC")
    Page<Material> searchAll(@Param("keyword") String keyword, Pageable pageable);
}