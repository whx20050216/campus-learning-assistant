# ============================================================
# 校园智能学习系统 — 环境变量模板（部署前必须修改）
# 复制为 .env 后填入真实值：cp .env.example .env
# ============================================================

# ---------------------------
# MySQL
# ---------------------------
MYSQL_ROOT_PASSWORD=CampusLearning2024
MYSQL_DB=learning_assistant
MYSQL_USER=cla_user
MYSQL_PASSWORD=ClaPassword2024

# ---------------------------
# Redis
# ---------------------------
REDIS_PASSWORD=

# ---------------------------
# MinIO
# ---------------------------
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CampusLearning2024
MINIO_BUCKET=learning-materials

# ---------------------------
# JWT（至少 32 字符，务必修改）
# ---------------------------
JWT_SECRET=campus-learning-assistant-jwt-secret-key-32chars
JWT_EXPIRATION=7200000

# ---------------------------
# Java 后端
# ---------------------------
LOG_LEVEL=INFO
JAVA_OPTS=-Xms512m -Xmx1024m

# ---------------------------
# Python AI 引擎
# ---------------------------
# 智谱 AI API Key（必须配置，否则双轨决策只能走本地 fallback）
ZHIPU_API_KEY=your_zhipu_api_key_here
CONFIDENCE_THRESHOLD=0.85

# ---------------------------
# CORS / Nginx
# ---------------------------
# 允许的跨域来源，多个用逗号分隔（包含前端域名或IP）
CORS_ALLOWED_ORIGINS=http://localhost,http://8.130.171.155
