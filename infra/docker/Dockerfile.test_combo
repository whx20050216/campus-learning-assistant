FROM python:3.9-slim
RUN apt-get update -qq && apt-get install -y -qq libgomp1 libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev poppler-utils && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir paddlepaddle==3.0.0 numpy==1.24.3 opencv-python==4.6.0.66
RUN python -c "import paddle; print('Paddle version:', paddle.__version__)"
RUN python -c "import cv2; print('cv2 OK')"
